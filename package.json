{
  "name": "ask-gemini-extension",
  "version": "1.9.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint src/ \"_locales/**/*.json\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "htmlhint \"src/**/*.html\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:purge": "node -e \"require('fs').rmSync('e2e/videos', { recursive: true, force: true })\"",
    "e2e": "npm run e2e:purge && playwright test --config=e2e/playwright.config.js",
    "e2e:stitch": "node e2e/stitch.mjs",
    "e2e:demo": "npm run e2e && npm run e2e:stitch"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-no-smart-quotes": "^2.0.1",
    "globals": "^17.13.0",
    "htmlhint": "^1.1.4",
    "jsdom": "^30.1.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "vitest": "^5.0.3"
  }
}
